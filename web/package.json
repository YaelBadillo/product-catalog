    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-plugin-query": "^5.108.4",
    "@testing-library/dom": "^10.4.2",
