# Local development only. Copy to .env (git-ignored); never commit real secrets.

# Postgres (docker compose `db` service)
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=catalog

# API. DATABASE_URL points at localhost for `make dev-api`;
# docker compose builds its own for the `db` host.
PORT=8080
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GIN_MODE=debug

# Web (inlined at build time): root of the API host
VITE_API_URL=http://localhost:8080
